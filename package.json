{
  "name": "npbinfo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "concurrently \"vite\" \"wrangler dev\"",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:og": "wrangler deploy --config og-worker/wrangler.jsonc",
    "dev:og": "wrangler dev --config og-worker/wrangler.jsonc --test-scheduled",
    "build:park-factors": "node scripts/build-hr-park-factors.mjs",
    "deploy:stats": "wrangler deploy --config stats-worker/wrangler.jsonc",
    "dev:stats": "wrangler dev --config stats-worker/wrangler.jsonc --test-scheduled"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
